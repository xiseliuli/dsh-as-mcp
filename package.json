{
  "name": "dsh-as-mcp",
  "version": "0.1.0",
  "description": "Expose this DeepSeek Harness as an MCP server so other agents can create workspaces, start sessions, write code through DSH, and run commands.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiseliuli/dsh-as-mcp.git"
  },
  "homepage": "https://github.com/xiseliuli/dsh-as-mcp#readme",
  "bugs": {
    "url": "https://github.com/xiseliuli/dsh-as-mcp/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "mcp",
    "model-context-protocol",
    "cordis-plugin",
    "bundle"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@10.8.0",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "icon": "./icon.svg",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "bin": {
    "dsh-as-mcp": "./bin/mcp-stdio.mjs"
  },
  "files": [
    "lib",
    "bin",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "icon.svg",
    "locale"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown && node scripts/build-client.mjs",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json",
    "test": "vitest run --passWithNoTests",
    "prepare": "tsdown && node scripts/build-client.mjs",
    "build:client": "node scripts/build-client.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "zod": "^4.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.5-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "^22.18.0",
    "@types/react": "~18.3.31",
    "esbuild": "^0.28.2",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "yaml": "^2.9.1"
  }
}
